{
  "name": "dubai-architecture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prebuild": "node scripts/optimize-images.mjs && node scripts/precreate-out.mjs && node scripts/build-tailwind.mjs && node scripts/generate-legacy-traps.mjs && npx tsx scripts/generate-llms-txt.mjs",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "index:google": "node scripts/push-indexing-api.mjs",
    "index:bing": "node scripts/push-indexnow.mjs",
    "index:all": "node scripts/push-indexing-api.mjs && node scripts/push-indexnow.mjs",
    "sync:dld": "node scripts/sync-dld-data.mjs",
    "analytics": "node scripts/analytics/cli.mjs",
    "analytics:verify": "node scripts/analytics/cli.mjs --verify",
    "analytics:gsc": "node scripts/analytics/cli.mjs --gsc",
    "analytics:ga4": "node scripts/analytics/cli.mjs --ga4",
